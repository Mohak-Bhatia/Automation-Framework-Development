<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests" thread-count="3">
	<parameter name="grid.enabled" value="true"/>
    <parameter name="grid.url" value="http://localhost:4444"/>
    
    <listeners>
		<listener class-name="TestComponents.Listeners"></listener>
	</listeners>

    <test name="UserStory Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
			<class name="tests.FunctionalTests" />
		</classes>
    </test>

    <test name="UserStory Edge">
        <parameter name="browser" value="edge"/>
        <classes>
			<class name="tests.FunctionalTests" />
		</classes>
    </test>

    <test name="UserStory Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
			<class name="tests.FunctionalTests" />
		</classes>
    </test>
    
    <test name="Validations Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
			<class name="tests.ErrorValidation" />
		</classes>
    </test>

    <test name="Validations Edge">
        <parameter name="browser" value="edge"/>
        <classes>
			<class name="tests.ErrorValidation" />
		</classes>
    </test>

    <test name="Validations Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
			<class name="tests.ErrorValidation" />
		</classes>
    </test>
	
</suite> <!--
Suite -->

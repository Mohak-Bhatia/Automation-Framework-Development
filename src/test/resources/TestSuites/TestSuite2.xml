<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium Grid - Products and Cart"
       parallel="tests"
       thread-count="3">

    <parameter name="grid.enabled" value="true"/>
    <parameter name="grid.url" value="http://localhost:4444"/>

    <groups>
        <run>
            <include name="Products And Cart"/>
        </run>
    </groups>

    <listeners>
        <listener class-name="TestComponents.Listeners"/>
    </listeners>

    <test name="Products and Cart - Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.ErrorValidation"/>
        </classes>
    </test>

    <test name="Products and Cart - Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.ErrorValidation"/>
        </classes>
    </test>

    <test name="Products and Cart - Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.ErrorValidation"/>
        </classes>
    </test>

</suite>